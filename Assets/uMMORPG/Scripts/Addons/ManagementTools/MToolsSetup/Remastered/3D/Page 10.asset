    search: "if (message.gameMaster == false ||\n                               
      conn == NetworkServer.localConnection)\n                            {\n                               
      // create new character based on the prefab.\n                               
      Player player = CreateCharacter(playerClasses[message.classIndex].gameObject,
      message.name, account, message.gameMaster);\n\n                               
      // addon system hooks\n                                onServerCharacterCreate.Invoke(message,
      player);\n\n                                // save the player\n                               
      Database.singleton.CharacterSave(player, false);\n                               
      Destroy(player.gameObject);\n\n                                // send available
      characters list again, causing\n                                // the client
      to switch to the character\n                                // selection scene
      again\n                                conn.Send(MakeCharactersAvailableMessage(account));\n                           
      }\n                            else\n                            {\n                               
      //Debug.Log(\"character insufficient permissions for GM request: \" + conn); 
      <- don't show on live server\n                                ServerSendError(conn,
      \"insufficient permissions\", false);\n                            }"
