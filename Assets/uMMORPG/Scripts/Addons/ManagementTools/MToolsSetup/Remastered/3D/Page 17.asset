  title: Step 17
  description: 
  path: Assets/uMMORPG/Scripts/Addons/ManagementTools/Editor/MToolsSetup
  fileName: MToolsSetup.cs
  text:
  - installed: 0
    search: //using Controller2k;
    replace: using Controller2k;
  - installed: 0
    search: "/*\r\n        UIGameMasterTool gmTool = Object.FindObjectOfType<UIGameMasterTool>();\r\n       
      if (gmTool != null)\r\n        {\r\n            gmTool.enabled = enabled;\r\n       
      }\r\n\r\n        UICharacterCreation characterCreation = Object.FindObjectOfType<UICharacterCreation>();\r\n       
      if (characterCreation != null)\r\n        {\r\n            characterCreation.gameMasterToggle.gameObject.SetActive(enabled);\r\n       
      }\r\n        */"
    replace: "UIGameMasterTool gmTool = Object.FindObjectOfType<UIGameMasterTool>();\r\n       
      if (gmTool != null)\r\n        {\r\n            gmTool.enabled = enabled;\r\n       
      }\r\n\r\n        UICharacterCreation characterCreation = Object.FindObjectOfType<UICharacterCreation>();\r\n       
      if (characterCreation != null)\r\n        {\r\n            characterCreation.gameMasterToggle.gameObject.SetActive(enabled);\r\n       
      }"
  - installed: 0
    search: "/*\r\n        if (asset.gameObject.TryGetComponent(out PlayerGameMasterTool
      component))\r\n        {\r\n            component.enabled = enable;\r\n       
      }\r\n\r\n        if (asset.gameObject.TryGetComponent(out CharacterController2k
      component2))\r\n        {\r\n            component2.collisionLayerMask = FindLayer(\"Environment\");\r\n       
      }\r\n        EditorUtility.SetDirty(asset);\r\n        AssetDatabase.SaveAssets();\r\n       
      AssetDatabase.Refresh();\r\n        */"
    replace: "if (asset.gameObject.TryGetComponent(out PlayerGameMasterTool component))\r\n       
      {\r\n            component.enabled = enable;\r\n        }\r\n\r\n        if
      (asset.gameObject.TryGetComponent(out CharacterController2k component2))\r\n       
      {\r\n            component2.collisionLayerMask = FindLayer(\"Environment\");\r\n       
      }\r\n        EditorUtility.SetDirty(asset);\r\n        AssetDatabase.SaveAssets();\r\n       
      AssetDatabase.Refresh();"
